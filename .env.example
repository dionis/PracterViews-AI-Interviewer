LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Plugins
GOOGLE_API_KEY=your_google_api_key

# Tavus (Primary Avatar)
TAVUS_API_KEY=your_tavus_api_key
REPLICA_ID=your_replica_id
PERSONA_ID=your_persona_id

# Beyond Presence (Fallback Avatar)
BEY_API_KEY=your_bey_api_key
BEY_AVATAR_ID=your_avatar_id

# ARTalk (Fallback 2 - Self-hosted GPU Avatar)
# URL of the remote ARTalk FastAPI server running on a GPU machine
ARTALK_SERVER_URL=http://your-gpu-server:8000
# Avatar replica ID — use "mesh" for the default 3D head, or a custom ID from create_avatar_replica.py
ARTALK_REPLICA_ID=mesh

# --- ARTalk Avatar Customization ---
# Umbral del fondo verde al aplicar el chromakey para Avatar (entero)
AVATAR_BG_THRESHOLD=50
# Imagen de entorno o escena (jpg, png) disponible en recursos
AVATAR_BACKGROUND_SCENE=background_office.jpg
